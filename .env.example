# Local-only storage override. Never use JSON storage in production.
# VECTOR_STORAGE=json
# VECTOR_DATA_DIR=/absolute/private/vector-data

# Production PostgreSQL. Required when NODE_ENV=production.
# DATABASE_URL=postgresql://vector:change-me@db:5432/vector

# At least 32 random characters. Generate with: openssl rand -base64 48
# SESSION_SECRET=replace-with-random-secret

# Optional canonical HTTPS origin for an explicitly configured reverse proxy.
# Omit for the loopback-only local app. This is not permission for public signup.
# VECTOR_APP_ORIGIN=https://your-vector.example

# Production worker and settlement configuration.
# WORKER_AUTH_SECRET=replace-with-another-random-secret
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# BASE_SEPOLIA_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
# BASE_SEPOLIA_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
# BASE_SEPOLIA_START_BLOCK=0
# BASE_SEPOLIA_CONFIRMATIONS=3
# BASE_SEPOLIA_REORG_OVERLAP_BLOCKS=12
# WALLETCONNECT_PROJECT_ID=replace-with-walletconnect-project-id
# EMAIL_FROM=Vector <no-reply@example.com>
# EMAIL_PROVIDER=log
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=replace-me
# SMTP_PASSWORD=replace-me
# DOCKER_GID=999 # numeric group id for /var/run/docker.sock on the VPS worker host

# Browser-visible Base Sepolia / WalletConnect settings for the settlement UI.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=replace-with-walletconnect-project-id
# NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# NEXT_PUBLIC_BASE_SEPOLIA_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
# NEXT_PUBLIC_BASE_SEPOLIA_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
