NODE_ENV=production
VECTOR_APP_ORIGIN=https://vector.example
DATABASE_URL=postgresql://vector:replace-me@db:5432/vector
SESSION_SECRET=replace-with-at-least-32-random-characters
WORKER_AUTH_SECRET=replace-with-at-least-32-random-characters
VERIFIER_IMAGE=registry.example/vector-verifier@sha256:replace-with-64-hex-digest
PUBLIC_REPOSITORY_HOSTS=github.com,gitlab.com,bitbucket.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_ESCROW_ADDRESS=replace-after-deployment
BASE_SEPOLIA_TOKEN_ADDRESS=replace-after-deployment
BASE_SEPOLIA_START_BLOCK=replace-with-deployment-block
BASE_SEPOLIA_CONFIRMATIONS=3
BASE_SEPOLIA_REORG_OVERLAP_BLOCKS=12
WALLETCONNECT_PROJECT_ID=replace-with-walletconnect-project-id
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=replace-with-walletconnect-project-id
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_BASE_SEPOLIA_ESCROW_ADDRESS=replace-after-deployment
NEXT_PUBLIC_BASE_SEPOLIA_TOKEN_ADDRESS=replace-after-deployment
EMAIL_FROM=Vector <no-reply@example.com>
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
DOCKER_GID=999

# One-time bootstrap command only; do not keep the password in the deployment environment.
# VECTOR_ADMIN_EMAIL=admin@example.com
# VECTOR_ADMIN_NAME=Vector Administrator
# VECTOR_ADMIN_PASSWORD=replace-after-bootstrap
