{
  "name": "vector-agent-escrow",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "start:container": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test lib/demo.test.ts && vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "migrate": "node scripts/migrate.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "admin:create": "node scripts/create-admin.mjs",
    "worker": "node --experimental-strip-types worker/index.ts",
    "worker:once": "node --experimental-strip-types worker/index.ts --once",
    "verify:reference": "node scripts/reference-verify.mjs",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=25.0.0"
  },
  "overrides": {
    "postcss": "8.5.28",
    "sharp": "0.35.5",
    "tmp": "0.2.7"
  },
  "dependencies": {
    "@ethereumjs/common": "10.1.3",
    "@ethereumjs/util": "10.1.3",
    "@ethereumjs/vm": "10.1.3",
    "@phosphor-icons/webcomponents": "2.1.0",
    "@walletconnect/ethereum-provider": "2.25.0",
    "lucide-react": "^0.468.0",
    "next": "15.5.27",
    "nodemailer": "^10.0.16",
    "pg": "^8.23.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "solc": "0.8.30",
    "tar": "^7.5.22",
    "viem": "^2.57.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.7.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitest/coverage-v8": "4.0.18",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.27",
    "typescript": "5.9.2",
    "vitest": "4.0.18"
  }
}
